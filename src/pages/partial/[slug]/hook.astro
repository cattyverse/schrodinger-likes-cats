---
import FramesTemplate from "../../../share/framesTemplate.astro";

export const partial = true;

export function getStaticPaths() {
	const metas = import.meta.glob<{ frames?: number; interval?: number }>(
		"../../../contents/*/meta.json",
		{ eager: true, import: "default" },
	);

	return Object.entries(metas).flatMap(([path, meta]) => {
		const slug = path.split("/").at(-2);
		if (!slug || !meta.frames || !meta.interval) {
			return [];
		}
		return [
			{
				params: { slug },
				props: { frames: meta.frames, interval: meta.interval },
			},
		];
	});
}

interface Props {
	frames: number;
	interval: number;
}

const { slug } = Astro.params;
const { frames, interval } = Astro.props;
---

{slug && (
	<FramesTemplate slug={slug} frames={frames} interval={interval} />
)}
