---
import PlayTemplate from "../components/playTemplate.svelte";
import Play from "../contents/schrodingers-cat/play.astro";
import { imageUrl, styleUrl } from "../scripts/url";

const slug = "schrodingers-cat";
const home = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<html lang="ja">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>404 Not Found</title>
		<link rel="icon" href={imageUrl("site", "logo.svg")} type="image/svg+xml">
		<link rel="stylesheet" href={styleUrl("global.css")}>
		<link rel="stylesheet" href={styleUrl("card.css")}>
	</head>
	<body>
		<main class="missing">
			<h1>404 Not Found</h1>
			<div class="card-play" data-play-root={slug}>
				<Play slug={slug} />
				<PlayTemplate slug={slug} embedded={true} client:load />
			</div>
			<a class="missing-home" href={home}>
				<img src={imageUrl("site", "logo.svg")} alt="" width="95" height="58">
				Back Home
			</a>
		</main>
	</body>
</html>

<style>
.missing {
	width: 100%;
	max-width: var(--card-max);
	margin-inline: auto;
	padding: 2rem 1rem 4.5rem;
}

.missing h1 {
	margin: 0;
	font-size: 1.35rem;
	font-weight: 650;
	letter-spacing: 0.08em;
	line-height: 1.4;
	text-align: center;
}

.missing-home {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0.4em;
	margin-block-start: 2.5rem;
	color: var(--muted);
	font-size: 0.875rem;
	letter-spacing: 0.04em;
	text-decoration: none;
}

.missing-home img {
	display: block;
	width: auto;
	height: 1em;
}

.missing-home:hover,
.missing-home:focus-visible {
	color: var(--ink);
}
</style>
