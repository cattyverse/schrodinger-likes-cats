---
import { imageUrl } from "../scripts/url";
import nav from "../site/ja/nav.json";
import ui from "../site/ja/ui.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = `${base}/`;
const here = Astro.url.pathname.replace(/\/$/, "");
const onHome = here === base || here === "";
const homeDefault = onHome && Astro.url.searchParams.size === 0;

const iso = new Intl.DateTimeFormat("en-CA", {
	timeZone: "Asia/Tokyo",
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
}).format(new Date());
const built = iso.replaceAll("-", ".");

function itemCurrent(path: string): boolean {
	const url = new URL(path, "https://cattyverse.com");
	const target = `${base}${url.pathname}`.replace(/\/$/, "");
	const samePath = here === target;
	if (url.searchParams.size > 0) {
		if (!samePath) {
			return false;
		}
		for (const [key, value] of url.searchParams) {
			if (Astro.url.searchParams.get(key) !== value) {
				return false;
			}
		}
		return true;
	}
	if (url.pathname === "/") {
		return homeDefault;
	}
	return samePath;
}
---

<header class="site-header">
	<a
		class="site-brand"
		href={home}
		aria-current={homeDefault ? "page" : undefined}
	>
		<img src={imageUrl("site", "logo.svg")} alt="" width="95" height="58">
		<span class="site-name">{ui.name}</span>
	</a>
	<p class="site-built">
		{ui.lastUpdated}
		{" "}
		<time datetime={iso}>{built}</time>
	</p>
	<nav class="site-nav" aria-label="サイト">
		{nav.map((item) => {
				const href = `${base}${item.path}`;
				return (
					<a href={href} aria-current={itemCurrent(item.path) ? "page" : undefined}>
						{item.label}
					</a>
				);
			})}
	</nav>
</header>

<style>
.site-header {
	width: 100%;
	max-width: var(--card-max);
	margin-inline: auto;
	padding-inline: 1rem;
	padding-block: 1rem 0.25rem;
}

.site-brand {
	display: inline-flex;
	align-items: center;
	gap: 0.7rem;
	min-height: var(--tap);
	text-decoration: none;
}

.site-brand img {
	display: block;
	width: auto;
	height: 2.25rem;
}

.site-name {
	color: var(--ink);
	font-size: 1.3125rem;
	font-weight: 600;
	letter-spacing: 0.01em;
	line-height: 1.2;
}

.site-brand:hover,
.site-brand:focus-visible {
	opacity: 0.7;
}

.site-built {
	display: block;
	margin-block: -0.35rem 0.35rem;
	color: var(--muted);
	font-size: 0.75rem;
	letter-spacing: 0.06em;
}

.site-nav {
	display: flex;
	flex-wrap: nowrap;
	gap: 0.25rem 1.35rem;
	overflow-x: auto;
	overscroll-behavior-x: contain;
	scrollbar-width: none;
}

.site-nav::-webkit-scrollbar {
	display: none;
}

.site-nav a {
	flex: none;
	display: inline-flex;
	align-items: center;
	min-height: var(--tap);
	color: var(--muted);
	font-size: 0.875rem;
	letter-spacing: 0.06em;
	text-decoration: none;
	white-space: nowrap;
}

.site-nav a:hover,
.site-nav a:focus-visible,
.site-nav a[aria-current="page"] {
	color: var(--ink);
}
</style>
