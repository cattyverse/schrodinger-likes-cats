---
import tagJa from "../tags/ja/tag.json";

interface Props {
	mode: "chip";
	id: string;
}

const { id } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const words = tagJa as Record<string, { label: string; description?: string }>;
const label = words[id]?.label ?? id;
---

<a class="tag-chip" href={`${base}/?tag=${encodeURIComponent(id)}`}>#{label}</a>
