---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { imageUrl, styleUrl } from "../scripts/url";
import ui from "../site/ja/ui.json";
import PlayTemplate from "./playTemplate.svelte";
import SiteHeader from "./siteHeader.astro";

interface Props {
	slug: string;
	title: string;
	description: string;
	image?: string;
	related: string[];
}

const { slug, title, description, image, related: relatedSlugs } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageUrl = new URL(`${base}/${slug}/`, Astro.site).href;
const ogSrc = image ? imageUrl(slug, image) : undefined;
const og = ogSrc
	? ogSrc.startsWith("http")
		? ogSrc
		: new URL(ogSrc, Astro.site).href
	: undefined;

const introductions = import.meta.glob<{ title: string }>(
	"../contents/*/ja/introduction.json",
	{ eager: true, import: "default" },
);
const metas = import.meta.glob<{ image?: string }>("../contents/*/meta.json", {
	eager: true,
	import: "default",
});

function idOf(path: string): string {
	const parts = path.split("/");
	const at = parts.lastIndexOf("contents");
	return at >= 0 ? (parts[at + 1] ?? "") : "";
}

const related = relatedSlugs.flatMap((id) => {
	const peer = Object.entries(introductions).find(
		([path]) => idOf(path) === id,
	)?.[1];
	const peerMeta = Object.entries(metas).find(
		([path]) => idOf(path) === id,
	)?.[1];
	if (!peer || !peerMeta?.image) {
		return [];
	}
	return [{ slug: id, title: peer.title, image: peerMeta.image }];
});

const plays = import.meta.glob<{ default: AstroComponentFactory }>(
	"../contents/*/play.astro",
	{ eager: true },
);
const Play = Object.entries(plays).find(([path]) => idOf(path) === slug)?.[1]
	?.default;
---

<html lang="ja">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{title}</title>
		<meta name="description" content={description}>
		<link rel="canonical" href={pageUrl}>
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={pageUrl}>
		<meta property="og:type" content="article">
		{og && <meta property="og:image" content={og} />}
		<link rel="icon" href={imageUrl("site", "logo.svg")} type="image/svg+xml">
		<link rel="stylesheet" href={styleUrl("global.css")}>
		<link rel="stylesheet" href={styleUrl("card.css")}>
	</head>
	<body>
		<SiteHeader />
		<main class="detail">
			<h1>{title}</h1>
			<p class="detail-lede">{description}</p>
			{Play && (
				<div class="card-play" data-play-root={slug}>
					<Play slug={slug} />
					<PlayTemplate slug={slug} embedded={true} client:load />
				</div>
			)}
			<article class="detail-body">
				<slot />
			</article>
			<section class="detail-related">
				<h2>{ui.related}</h2>
				<div class="detail-related-row">
					{related.map((item) => (
							<a href={`${base}/${item.slug}/`}>
								<img
									src={imageUrl(item.slug, item.image)}
									alt=""
									width="1200"
									height="630"
								/>
								<span>{item.title}</span>
							</a>
						))}
				</div>
			</section>
		</main>
	</body>
</html>

<style>
.detail {
	width: 100%;
	max-width: var(--card-max);
	margin-inline: auto;
	padding: 2rem 1rem 4.5rem;
}

.detail h1 {
	margin: 0;
	font-size: 1.35rem;
	font-weight: 650;
	letter-spacing: 0.08em;
	line-height: 1.4;
}

.detail-lede {
	margin-block: 0.9em 1.5em;
	font-size: 1.05rem;
	font-weight: 600;
	line-height: 1.45;
}

.detail-body {
	margin-block: 2rem 3rem;
	font-size: 1rem;
	line-height: 1.75;
}

.detail-body > :first-child {
	margin-block-start: 0;
}

.detail-related h2 {
	margin: 0 0 0.75rem;
	color: var(--muted);
	font-size: 0.75rem;
	font-weight: 500;
	letter-spacing: 0.08em;
}

.detail-related-row {
	display: flex;
	flex-wrap: nowrap;
	gap: 1rem;
	min-height: 6rem;
	overflow-x: auto;
	overscroll-behavior-x: contain;
	scrollbar-width: none;
}

.detail-related-row::-webkit-scrollbar {
	display: none;
}

.detail-related a {
	flex: none;
	width: 12rem;
	color: inherit;
	text-decoration: none;
}

.detail-related img {
	display: block;
	width: 100%;
	aspect-ratio: 1200 / 630;
	object-fit: cover;
	background: var(--tint);
}

.detail-related span {
	display: block;
	margin-block-start: 0.4rem;
	font-size: 0.875rem;
	line-height: 1.4;
}
</style>
